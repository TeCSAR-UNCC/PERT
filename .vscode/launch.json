  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pert_train_ntu",
      "type": "python",
      "request": "launch",
      "program": "train_2d.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/nturgbd/pert12_h5_ntu.yaml"]
    },
    {
      "name": "poseBert_emd Train",
      "type": "python",
      "request": "launch",
      "program": "train_2d.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/panoptic/posebert_pan_gcn.yaml"]
    },
    {
      "name": "view_frames",
      "type": "python",
      "request": "launch",
      "program": "view_frames.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/panoptic/posebert_pan_gcn.yaml"]
    },
    {
      "name": "Heatmap generator",
      "type": "python",
      "request": "launch",
      "program": "testing_things.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/PERT/pert.yaml"]
    },
    {
      "name": "dVAE",
      "type": "python",
      "request": "launch",
      "program": "train_vae_pose.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/dVAE/dVAE_2d4x_res1x.yaml"],
      "env": {
        "CUDA_VISIBLE_DEVICES": "2",
        "WANDB_MODE": "offline"
      }
    },
    {
      "name": "PERT_BEiT",
      "type": "python",
      "request": "launch",
      "program": "pretrain_pert.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/PERT/pert.yaml"],
      "env": {
        "WANDB_MODE": "offline"
      }
    },
    {
      "name": "pert_config",
      "type": "python",
      "request": "launch",
      "program": "./configs/config.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["configs/PERT/pert.yaml"]
    }
  ]
}
