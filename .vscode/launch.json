  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "view_frames",
      "type": "debugpy",
      "request": "launch",
      "program": "view_frames.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/PERT/PEiT_panntu.yaml"],
      "env": {
        "WANDB_MODE": "offline",
        "CUDA_VISIBLE_DEVICES": "2"
      }
    },
    {
      "name": "beit_view_frames",
      "type": "debugpy",
      "request": "launch",
      "program": "view_frames_beit.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--cfg", "configs/PERT/PEiT_panntu.yaml"],
      "env": {
        "WANDB_MODE": "offline",
        "CUDA_VISIBLE_DEVICES": "1"
      }
    },
    {
      "name": "Heatmap generator",
      "type": "debugpy",
      "request": "launch",
